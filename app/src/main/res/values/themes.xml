<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Fision" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Accent secondary (Design pref). Default matches the green pair. -->
        <item name="accentSecondary">@color/accent_green_secondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Default for every TextInputLayout. -->
        <item name="textInputStyle">@style/Widget.Fision.TextInputLayout</item>
    </style>
    <!-- Splash: black window; FisionSplashView draws the animation on top.
         Same in light and dark mode (no values-night copy); values-v31 adds the
         blank system splash of Android 12+. -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>


    <!-- Styles for Material Button with icon only -->

    <style name="Widget.MaterialComponents.Button.IconOnly" >
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">12dp</item>
        <item name="android:minHeight">12dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Styles for rounded circle -->

    <style name="ShapeAppearanceOverlay.MyApp.Button.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Song cover: soft rounded corners -->
    <style name="ShapeAppearanceOverlay.Fision.Cover.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Translucent dialog that allows a blur behind it (Android 12+). Low dim (0.2)
         to keep the frosted glass background visible. -->
    <style name="Theme.Fision.BlurDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.2</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Do not force a huge min width: let the content decide -->
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="ModalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/button_background_color</item>
        <item name="android:strokeColor">@color/AppDarkGrey</item>
        <item name="android:textColor">@color/button_text_color</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
        <item name="android:strokeWidth">4</item>
    </style>

    <!-- ImportActivity helpers -->
    <style name="ImportSectionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/AppWhite</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
    </style>

    <style name="ImportSubLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/AppWhite</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
    </style>

    <!-- Toggle group buttons with app styling (colorPrimary when selected,
         translucent gray otherwise; 14sp text for readability).
         Moderate cornerRadius (14dp): rounded rect on every button. Material 1.12
         does not expose innerCornerSize, so a large radius (100dp) made each button
         render as an independent pill forming visual "eyes" when joined. 14dp gives
         a homogeneous "soft chip" look. -->
    <style name="ImportSegmentButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/AppWhite</item>
        <item name="android:textSize">12sp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <!-- "Song info" rows inside the rename dialog (label on the left, value on the right). -->
    <style name="SongInfoRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="SongInfoLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#919191</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
    </style>

    <style name="SongInfoValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/AppWhite</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Single text field style for the whole app: outlined, 12dp corners (in
         line with the cards), stroke in the separator tone and white when
         focused. Every TextInputLayout uses it. -->
    <style name="Widget.Fision.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/dialog_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/AppWhite</item>
        <item name="android:textColorHint">#9E9E9E</item>
        <item name="cursorColor">?attr/colorPrimary</item>
        <item name="cursorErrorColor">?attr/colorPrimary</item>
    </style>

    <!-- EditText overlay: forces colorPrimary on the selection handles (drops)
         and the cursor. Without this, the handles inherit the default Material purple. -->
    <style name="EditTextHandleTheme" parent="ThemeOverlay.MaterialComponents">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
    </style>

    <!-- Design preference: accent overlays applied per Activity from AccentColorManager.
         Each overrides colorPrimary + Material control tints so widgets, tints,
         and any ?attr/colorPrimary reference across the app follow the pick. -->
    <style name="ThemeOverlay.Fision.Accent" parent="">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorControlActivated">@color/accent_green</item>
        <item name="accentSecondary">@color/accent_green_secondary</item>
    </style>
    <style name="ThemeOverlay.Fision.Accent.Green">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorControlActivated">@color/accent_green</item>
        <item name="accentSecondary">@color/accent_green_secondary</item>
    </style>
    <style name="ThemeOverlay.Fision.Accent.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="accentSecondary">@color/accent_blue_secondary</item>
    </style>
    <style name="ThemeOverlay.Fision.Accent.Purple">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="colorControlActivated">@color/accent_purple</item>
        <item name="accentSecondary">@color/accent_purple_secondary</item>
    </style>
    <style name="ThemeOverlay.Fision.Accent.Amber">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorAccent">@color/accent_amber</item>
        <item name="colorControlActivated">@color/accent_amber</item>
        <item name="accentSecondary">@color/accent_amber_secondary</item>
    </style>

    <!-- "Chip" CheckBox for Import stems: rounded state-list background (translucent colorPrimary
         when checked, soft white outline otherwise), generous side padding for a card-like feel. -->
    <style name="ImportStemCheck" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/AppWhite</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/yugothic_ui_regular</item>
        <item name="buttonTint">?attr/colorPrimary</item>
        <item name="android:background">@drawable/stem_check_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

</resources>