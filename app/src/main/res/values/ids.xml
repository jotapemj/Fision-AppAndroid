<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon resource bound to an import stem tile (cross-fade on change) -->
    <item name="tag_import_icon_res" type="id" />
    <!-- Records the accent id applied to an Activity theme so we can detect
         stale themes on the next onResume and trigger recreate. -->
    <item name="accent_applied_tag" type="id" />
    <!-- Artwork key bound to a playlist cover view (drops late results) -->
    <item name="tag_playlist_cover_key" type="id" />
    <!-- Running style animation of a lyrics row (active line change) -->
    <item name="tag_lyrics_anim" type="id" />
    <!-- Visibility target of a stem FX control while it fades -->
    <item name="tag_fx_visible" type="id" />
</resources>
