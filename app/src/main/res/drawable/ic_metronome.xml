    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="500"
    android:viewportHeight="500"
    android:tint="#FFFFFF">

    <group
        android:pivotX="250"
        android:pivotY="250"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <path
            android:strokeColor="@android:color/white"
            android:strokeWidth="27.78"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
