<?xml version="1.0" encoding="utf-8"?>
<!-- Play, split in two halves for the play/pause morph. Fill plus a round
     joined stroke of the same color softens the corners. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:name="left_bar"
        android:pathData="M5.8,4 L5.8,20 L12,16.06 L12,7.94 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round" />
    <path
        android:name="right_bar"
        android:pathData="M12,7.94 L12,16.06 L18.4,12 L18.4,12 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round" />
</vector>
