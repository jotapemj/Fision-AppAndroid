<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/AppDarkGrey">

    <item android:id="@android:id/background"> <!-- Button background -->
        <shape android:shape="rectangle">
            <solid android:color="@color/black"/> <!-- Normal background color -->
            <corners android:radius="4dp"/> <!-- Rounded corners if desired -->
        </shape>
    </item>

    <item android:id="@android:id/mask"> <!-- Ripple effect mask -->
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/> <!-- Mask color -->
            <corners android:radius="4dp"/> <!-- Rounded corners if desired -->
        </shape>
    </item>

</ripple>