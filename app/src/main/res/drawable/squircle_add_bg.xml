<?xml version="1.0" encoding="utf-8"?>
<!-- Add button shape: black fill, same 20dp corners and 1dp grey edge as the
     search bar beside it, so both read as one family. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/AppDarkGrey" />
</shape>
