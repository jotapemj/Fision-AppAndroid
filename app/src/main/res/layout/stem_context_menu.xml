<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="140dp"
    android:padding="4dp"
    android:background="@drawable/stem_context_menu_bg">

    <TextView
        android:id="@+id/tv_stemMenuSolo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textColor="@color/AppWhite"
        android:textSize="15sp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/stem_menu_solo" />

    <TextView
        android:id="@+id/tv_stemMenuMute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textColor="@color/AppWhite"
        android:textSize="15sp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/stem_menu_mute" />

</LinearLayout>
