<?xml version="1.0" encoding="utf-8"?>
<!--
    Dance panel of the 3D views (flat and scene include one copy each). Shown
    while the dance runs: tabs pick which value the single large slider edits
    (speed, distance, swing of one stem). As tall as the two stacked buttons.
    The chevron folds it into a slim tab (content gone) and opens it again.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_3d_dancePanel"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="12dp"
    android:background="@drawable/dance_panel_bg"
    android:orientation="horizontal"
    android:visibility="gone">

    <ImageView
        android:id="@+id/iv_3d_danceChevron"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:scaleType="center"
        android:rotation="180"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="@string/stems_dance_title" />

    <LinearLayout
        android:id="@+id/ll_3d_danceContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:paddingEnd="10dp">

        <!-- Tabs over a sliding accent pill (painted in code). -->
        <FrameLayout
            android:id="@+id/fl_3d_danceTabs"
            android:layout_width="match_parent"
            android:layout_height="32dp">

            <View
                android:id="@+id/v_3d_danceTabIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_3d_danceTabSpeed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_regular"
                    android:text="@string/stems_dance_speed"
                    android:textColor="@color/AppWhite"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_3d_danceTabDistance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_regular"
                    android:text="@string/stems_dance_distance"
                    android:textColor="@color/AppWhite"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_3d_danceTabSwing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_regular"
                    android:text="@string/dance_tab_swing"
                    android:textColor="@color/AppWhite"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Slider row: [swing stem] slider value -->
        <LinearLayout
            android:id="@+id/ll_3d_danceSliderRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Swing tab: stem whose swing the slider edits; tap =
                 next swinging stem. -->
            <ImageView
                android:id="@+id/iv_3d_danceSwingStem"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/stems_dance_osc_speed"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_3d_danceSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:valueFrom="0.02"
                    android:valueTo="0.4"
                    android:value="0.15"
                    android:stepSize="0.01"
                    app:trackHeight="4dp"
                    app:thumbRadius="9dp"
                    app:trackColorActive="?attr/colorPrimary"
                    app:trackColorInactive="@color/BottomSheetColor"
                    app:thumbColor="?attr/accentSecondary"
                    app:haloRadius="0dp"
                    app:labelBehavior="gone"
                    app:tickVisible="false" />

                <!-- Range of the scene (metres); the flat view sets its own in code. -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_3d_danceDistance"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:valueFrom="0.3"
                    android:valueTo="3.0"
                    android:value="1.5"
                    android:stepSize="0.05"
                    app:trackHeight="4dp"
                    app:thumbRadius="9dp"
                    app:trackColorActive="?attr/colorPrimary"
                    app:trackColorInactive="@color/BottomSheetColor"
                    app:thumbColor="?attr/accentSecondary"
                    app:haloRadius="0dp"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    android:visibility="gone" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_3d_danceOsc"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:valueFrom="0.1"
                    android:valueTo="2.0"
                    android:value="0.5"
                    android:stepSize="0.05"
                    app:trackHeight="4dp"
                    app:thumbRadius="9dp"
                    app:trackColorActive="?attr/colorPrimary"
                    app:trackColorInactive="@color/BottomSheetColor"
                    app:thumbColor="?attr/accentSecondary"
                    app:haloRadius="0dp"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_3d_danceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="@font/noto_sans_regular"
                android:textColor="@color/AppWhite"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
