<?xml version="1.0" encoding="utf-8"?>
<!--
  "About" dialog: app name, version and developer. The licenses list lives
  in a dedicated LicensesActivity opened from the "View licenses" button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <!-- Logo + app name -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/AppWhite"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/noto_sans_regular" />

    <TextView
        android:id="@+id/tv_about_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/noto_sans_regular"
        tools:text="v1.0.0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:text="@string/about_developer"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/noto_sans_regular" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_about_licenses"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:padding="10dp"
        android:text="@string/about_view_licenses"
        android:textColor="@color/AppWhite"
        app:icon="@drawable/ic_license"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:rippleColor="?attr/colorPrimary"
        app:cornerRadius="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_about_tour"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="@string/settings_tour_title"
        android:textColor="@color/AppWhite"
        app:icon="@drawable/ic_tour"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:rippleColor="?attr/colorPrimary"
        app:cornerRadius="20dp" />

    <!-- Local mode, demo song not in the library: download and import it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_about_demo"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="@string/settings_demo_download"
        android:textColor="@color/AppWhite"
        android:visibility="gone"
        app:icon="@drawable/ic_github"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:rippleColor="?attr/colorPrimary"
        app:cornerRadius="20dp" />

    <!-- Legacy TextView kept for compatibility with existing find-by-id code
         but no longer rendered. Height 0 keeps it invisible without touching
         the About activity setup. -->
    <TextView
        android:id="@+id/tv_about_libraries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_about_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="@string/dialog_close"
        android:textColor="@color/AppWhite"
        android:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="20dp" />

</LinearLayout>
