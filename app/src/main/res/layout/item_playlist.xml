<?xml version="1.0" encoding="utf-8"?>
<!-- Row of the Playlists tab: artwork, title, song count. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/row_pressed_flat">

    <FrameLayout
        android:id="@+id/fl_playlistCoverWrap"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/cover_clip_bg"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_playlistCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_playlistTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/noto_sans_regular"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_playlistCount"
        app:layout_constraintEnd_toStartOf="@+id/ib_playlistOptions"
        app:layout_constraintStart_toEndOf="@+id/fl_playlistCoverWrap"
        app:layout_constraintTop_toTopOf="@+id/fl_playlistCoverWrap"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_playlistCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/noto_sans_regular"
        android:maxLines="1"
        android:textColor="#919191"
        android:textSize="12.5sp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_playlistCoverWrap"
        app:layout_constraintEnd_toStartOf="@+id/ib_playlistOptions"
        app:layout_constraintStart_toEndOf="@+id/fl_playlistCoverWrap"
        app:layout_constraintTop_toBottomOf="@+id/tv_playlistTitle" />

    <ImageButton
        android:id="@+id/ib_playlistOptions"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_more"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
