<?xml version="1.0" encoding="utf-8"?>
<!--
    Chord diagram view (piano / guitar / ukulele) and chord grid. Overlay of
    the central player area like the lyrics view. With diagrams it starts
    below the chord carousel, which stays visible on top; the grid replaces
    the carousel, so the view moves up to the top (margin set in code).
    Transparent, so the animated background shows through.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chordDiagram_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="71dp"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Diagrams / Grid. -->
    <com.jotapeveloper.fision.chords.SlidingChipSelector
        android:id="@+id/sel_chordView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="96dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_chordDiagramPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.jotapeveloper.fision.chords.SlidingChipSelector
                android:id="@+id/sel_chordInstrument"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="80dp" />

            <com.jotapeveloper.fision.chords.ChordStageView
                android:id="@+id/stage_chordDiagram"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1" />

            <com.jotapeveloper.fision.chords.SlidingChipSelector
                android:id="@+id/sel_chordZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_marginEnd="64dp"
                android:layout_marginBottom="14dp" />
        </LinearLayout>

        <!-- Chord grid: fades only where more rows are hidden. -->
        <com.jotapeveloper.fision.FadingEdgeRecyclerView
            android:id="@+id/rv_chordGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
