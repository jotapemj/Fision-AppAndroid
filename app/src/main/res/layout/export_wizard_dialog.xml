<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <TextView
        android:id="@+id/tv_wizardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:textColor="@color/AppWhite"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Dynamic body: content swaps between steps with a fade -->
    <FrameLayout
        android:id="@+id/fl_wizardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/ll_wizardOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </FrameLayout>

    <!-- Extras: metronome checkbox box (visible where applicable) -->
    <LinearLayout
        android:id="@+id/ll_wizardExtras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_wizardIncludeMetronome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/AppWhite"
            android:fontFamily="@font/yugothic_ui_regular"
            android:text="@string/export_include_metronome" />

    </LinearLayout>

    <!-- Progress (visible only during render) -->
    <LinearLayout
        android:id="@+id/ll_wizardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_wizardProgressSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#919191"
            android:fontFamily="@font/yugothic_ui_regular"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/pb_wizardExport"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="@color/colorPrimary"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

    <!-- Footer buttons: Back | flexible space | Cancel | Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_wizardBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_back"
            android:textColor="@color/AppWhite"
            app:rippleColor="@color/colorPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_wizardCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@android:string/cancel"
            android:textColor="@color/AppWhite"
            app:strokeColor="@color/colorPrimary"
            app:rippleColor="@color/colorPrimary"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_wizardSave"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:visibility="gone"
            android:text="@string/export_save"
            android:textColor="@color/colorPrimary"
            app:strokeColor="@color/colorPrimary"
            app:rippleColor="@color/colorPrimary"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
