<?xml version="1.0" encoding="utf-8"?>
<!-- Grid tile for the stems dance dialog: large square icon area, a thin
     horizontal divider and a borderless "swing" toggle (per-stem up/down
     oscillation, scene mode only). Selection is signalled by an overlay
     ring whose alpha is toggled. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dance_stem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_dance_stem_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="24dp"
                android:scaleType="fitCenter"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription"
                tools:src="@drawable/ic_export" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/v_dance_stem_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#4D808080" />

        <TextView
            android:id="@+id/tv_dance_stem_swing"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/noto_sans_regular"
            android:text="@string/dance_swing"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Selection ring, drawn on top of the content. Alpha-toggled only, so
         a selection change never triggers a re-measure. -->
    <View
        android:id="@+id/v_dance_stem_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</com.google.android.material.card.MaterialCardView>
