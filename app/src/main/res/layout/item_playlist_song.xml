<?xml version="1.0" encoding="utf-8"?>
<!-- Song row used by the playlist screens. The drag handle and the end
     action (remove / check) are shown per screen. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/row_pressed_flat">

    <ImageView
        android:id="@+id/iv_psDrag"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:scaleType="center"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone"
        android:contentDescription="@string/playlist_reorder"
        app:tint="#8A8A8A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <FrameLayout
        android:id="@+id/fl_psCoverWrap"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/cover_clip_bg"
        android:clipToOutline="true"
        app:layout_goneMarginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/iv_psDrag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_psCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Not downloaded yet -->
        <View
            android:id="@+id/v_psCoverDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000"
            android:visibility="gone" />

        <!-- Not downloaded while signed out: sign in to use it -->
        <ImageView
            android:id="@+id/iv_psCoverLock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_psTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/noto_sans_regular"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_psArtist"
        app:layout_constraintEnd_toStartOf="@+id/ib_psAction"
        app:layout_constraintStart_toEndOf="@+id/fl_psCoverWrap"
        app:layout_constraintTop_toTopOf="@+id/fl_psCoverWrap"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="20dp" />

    <TextView
        android:id="@+id/tv_psArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/noto_sans_regular"
        android:maxLines="1"
        android:textColor="#919191"
        android:textSize="12.5sp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_psCoverWrap"
        app:layout_constraintEnd_toStartOf="@+id/ib_psAction"
        app:layout_constraintStart_toEndOf="@+id/fl_psCoverWrap"
        app:layout_constraintTop_toBottomOf="@+id/tv_psTitle"
        app:layout_goneMarginEnd="20dp" />

    <ImageButton
        android:id="@+id/ib_psAction"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="?selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:visibility="gone"
        app:tint="#8A8A8A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
