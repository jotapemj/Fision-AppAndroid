<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/tv_AppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_fision_wordmark"
                android:contentDescription="@string/app_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_settings"
                style="@style/Widget.MaterialComponents.Button.IconOnly"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/b_settings_description"
                android:onClick="openSettings"
                app:icon="@drawable/ic_settings"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_goneMarginEnd="10dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

            <!-- Session avatar: overlaid on the settings button, shown only when
                 a user is signed in. Toggled from MainActivity. Constrained to
                 b_settings so both share the same spot. -->
            <FrameLayout
                android:id="@+id/fl_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:visibility="gone"
                android:background="@drawable/avatar_circle_bg"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:translationZ="8dp"
                app:layout_constraintStart_toStartOf="@+id/b_settings"
                app:layout_constraintEnd_toEndOf="@+id/b_settings"
                app:layout_constraintTop_toTopOf="@+id/b_settings"
                app:layout_constraintBottom_toBottomOf="@+id/b_settings">
                <TextView
                    android:id="@+id/tv_avatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/noto_sans_regular"
                    android:textStyle="bold"
                    android:textColor="#CFCFCF"
                    android:textSize="16sp"
                    tools:text="J" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatarImage"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
            </FrameLayout>

            <!-- Fision server connection state: green online / red offline / grey local.
                 Start side, mirroring the settings button on the end side. -->
            <ImageView
                android:id="@+id/iv_cloud_status"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cloud"
                android:contentDescription="@string/server_status_offline"
                app:tint="@color/cloud_offline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/b_settings"
                app:layout_constraintBottom_toBottomOf="@+id/b_settings" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans_regular"
        android:text="@string/tv_title"
        android:textColor="@color/AppWhite"
        android:textSize="34sp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <!-- Search EditText -->
    <EditText
        android:id="@+id/et_find"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_edittext_background"
        android:ems="10"
        android:fontFamily="@font/noto_sans_regular"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:hint="@string/te_find"
        android:drawableLeft="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableRight="@drawable/ic_clear"
        android:inputType="textPersonName"
        android:imeOptions="actionSearch"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:textColor="#8A8A8A"
        android:autofillHints=""
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/b_add"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        app:layout_goneMarginEnd="20dp" />

    <!-- Add Button: black rounded square (search bar corners) with a white mark beside the search bar
         (hidden while searching, the bar then takes the full width) -->
    <ImageButton
        android:id="@+id/b_add"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:background="@drawable/squircle_add_button"
        android:src="@drawable/ic_fision_mark"
        app:tint="#FFFFFF"
        android:onClick="addSong"
        android:contentDescription="@string/b_add"
        android:tooltipText="@string/b_add"
        app:layout_constraintTop_toTopOf="@+id/et_find"
        app:layout_constraintBottom_toBottomOf="@+id/et_find"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp" />

    <!-- Songs Count -->
    <TextView
        android:id="@+id/tv_SongsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans_regular"
        android:text="@string/tv_SongsCount"
        android:textColor="@color/AppDarkGrey"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/et_find"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/b_orderBy"
        app:layout_constraintBottom_toTopOf="@+id/swipeRefreshLayout"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="15dp"/>

    <!-- Order by button -->
    <ImageButton
        android:id="@+id/b_orderBy"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@raw/ic_orderby"
        android:scaleType="fitCenter"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/order_by_title"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@+id/tv_SongsCount"
        app:layout_constraintBottom_toBottomOf="@+id/tv_SongsCount"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView inside SwipeRefreshLayout.
         The RV extends to the bottom of the screen (constraintBottom_toBottom=parent)
         and leaves padding-bottom so items are not clipped behind the mini-player.
         This way the mini-player's rounded corners show the list items underneath,
         instead of the activity's black background. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_SongsCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bnv_main"
        app:layout_goneMarginTop="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_songList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            app:fastScrollEnabled="true"
            app:fastScrollHorizontalThumbDrawable="@drawable/scroll_thumb"
            app:fastScrollHorizontalTrackDrawable="@drawable/scroll_line"
            app:fastScrollVerticalThumbDrawable="@drawable/scroll_thumb"
            app:fastScrollVerticalTrackDrawable="@drawable/scroll_line"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Edge fades over the song list, shown only while songs remain beyond
         that edge (MainActivity.updateListFades). Drawn under the mini-player. -->
    <View
        android:id="@+id/v_main_fadeTop"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:background="@drawable/list_fade_top"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@+id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/v_main_fadeBottom"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:background="@drawable/list_fade_bottom"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search with no matches. -->
    <TextView
        android:id="@+id/tv_noResults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/no_results"
        android:textColor="#8A8A8A"
        android:textSize="17sp"
        android:fontFamily="@font/noto_sans_regular"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty library: dashed card that adds the first song -->
    <LinearLayout
        android:id="@+id/ll_songsAddFirst"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/dashed_add_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:onClick="addSong"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/swipeRefreshLayout"
        app:layout_constraintBottom_toBottomOf="@+id/swipeRefreshLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_songsAddFirst"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:importantForAccessibility="no"
            app:tint="#8A8A8A" />

        <TextView
            android:id="@+id/tv_songsAddFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/noto_sans_regular"
            android:text="@string/songs_empty"
            android:textColor="#8A8A8A"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Playlists tab: replaces the songs tab content under the title. -->
    <include
        android:id="@+id/cl_playlistsTab"
        layout="@layout/main_playlists_tab"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bnv_main" />

    <!-- Bottom tabs: Songs / Playlists. -->
    <View
        android:id="@+id/v_main_tabsDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bnv_main" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bnv_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp"
        app:itemIconTint="@color/main_tab_item"
        app:itemTextColor="@color/main_tab_item"
        app:itemRippleColor="@android:color/transparent"
        app:itemBackground="@null"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_tabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        layout="@layout/mini_player"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bnv_main" />

</androidx.constraintlayout.widget.ConstraintLayout>
