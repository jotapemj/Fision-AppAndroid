<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_AppIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/iv_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/fision_logo" />

            <TextView
                android:id="@+id/tv_AppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/good_times_rg"
                android:text="@string/app_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_AppIcon"
                app:layout_constraintBottom_toBottomOf="@+id/iv_AppIcon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_settings"
                style="@style/Widget.MaterialComponents.Button.IconOnly"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/b_settings_description"
                android:onClick="openSettings"
                app:icon="@drawable/ic_settings"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_AppIcon"
                app:layout_constraintBottom_toBottomOf="@+id/iv_AppIcon"
                app:layout_goneMarginEnd="10dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

            <!-- Session avatar: overlaid on the settings button, shown only when
                 a user is signed in. Toggled from MainActivity. Constrained to
                 b_settings so the cloud icon can keep anchoring to the same spot
                 regardless of which one is currently visible. -->
            <FrameLayout
                android:id="@+id/fl_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:visibility="gone"
                android:background="@drawable/avatar_circle_bg"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:translationZ="8dp"
                app:layout_constraintStart_toStartOf="@+id/b_settings"
                app:layout_constraintEnd_toEndOf="@+id/b_settings"
                app:layout_constraintTop_toTopOf="@+id/b_settings"
                app:layout_constraintBottom_toBottomOf="@+id/b_settings">
                <TextView
                    android:id="@+id/tv_avatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:textStyle="bold"
                    android:textColor="#CFCFCF"
                    android:textSize="16sp"
                    tools:text="J" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatarImage"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
            </FrameLayout>

            <!-- Fision server connection state: green online / red offline / grey local -->
            <ImageView
                android:id="@+id/iv_cloud_status"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cloud"
                android:contentDescription="@string/server_status_offline"
                app:tint="@color/cloud_offline"
                app:layout_constraintEnd_toStartOf="@+id/b_settings"
                app:layout_constraintTop_toTopOf="@+id/b_settings"
                app:layout_constraintBottom_toBottomOf="@+id/b_settings" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yugothic_ui_regular"
        android:text="@string/tv_title"
        android:textColor="@color/AppWhite"
        android:textSize="34sp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <!-- Search EditText -->
    <EditText
        android:id="@+id/et_find"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_edittext_background"
        android:ems="10"
        android:fontFamily="@font/yugothic_ui_regular"
        android:hint="@string/te_find"
        android:drawableLeft="@drawable/ic_search"
        android:drawablePadding="7dp"
        android:drawableRight="@drawable/ic_clear"
        android:inputType="textPersonName"
        android:paddingEnd="10dp"
        android:textColor="#8A8A8A"
        android:autofillHints=""
        app:endIconMode="clear_text"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <!-- Add Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_add"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/colorPrimary"
        android:fontFamily="@font/yugothic_ui_regular"
        android:onClick="addSong"
        android:text="@string/b_add"
        android:textColor="#FFFFFF"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle"
        app:layout_constraintTop_toBottomOf="@+id/et_find"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        />

    <!-- Songs Count -->
    <TextView
        android:id="@+id/tv_SongsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yugothic_ui_regular"
        android:text="@string/tv_SongsCount"
        android:textColor="@color/AppDarkGrey"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/b_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/b_orderBy"
        app:layout_constraintBottom_toTopOf="@+id/swipeRefreshLayout"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="5dp"/>

    <!-- Order by button -->
    <ImageButton
        android:id="@+id/b_orderBy"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@raw/ic_orderby"
        android:scaleType="fitCenter"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/order_by_title"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@+id/tv_SongsCount"
        app:layout_constraintBottom_toBottomOf="@+id/tv_SongsCount"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView inside SwipeRefreshLayout.
         The RV extends to the bottom of the screen (constraintBottom_toBottom=parent)
         and leaves padding-bottom so items are not clipped behind the mini-player.
         This way the mini-player's rounded corners show the list items underneath,
         instead of the activity's black background. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_SongsCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_songList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            app:fastScrollEnabled="true"
            app:fastScrollHorizontalThumbDrawable="@drawable/scroll_thumb"
            app:fastScrollHorizontalTrackDrawable="@drawable/scroll_line"
            app:fastScrollVerticalThumbDrawable="@drawable/scroll_thumb"
            app:fastScrollVerticalTrackDrawable="@drawable/scroll_line"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Mini-player (visible when the service has a song loaded).
         A BlurBehindLayout that paints a blur of the content behind it
         (list RV, connected via setSourceView from MainActivity). Telegram-style
         bar: frosted glass letting color and motion show through. -->
    <com.jotapeveloper.fision.BlurBehindLayout
        android:id="@+id/mini_player"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/mini_player_bg"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_mini_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/iv_icon"
            app:srcCompat="@drawable/ic_media"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Wrapper that clips the translated text. Starts 5dp after the cover and
             ends right where the play button begins. Three stacked LinearLayouts
             (current/prev/next) receive translateX for the swipe + preview effect. -->
        <FrameLayout
            android:id="@+id/fl_mini_textWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            app:layout_constraintStart_toEndOf="@+id/iv_mini_icon"
            app:layout_constraintEnd_toStartOf="@+id/b_mini_playPause"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Current song -->
            <LinearLayout
                android:id="@+id/ll_mini_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/AppWhite"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_mini_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textColor="#919191"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Previous song (preview on the left during swipe →) -->
            <LinearLayout
                android:id="@+id/ll_mini_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mini_titlePrev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/AppWhite"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_mini_artistPrev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textColor="#919191"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Next song (preview on the right during swipe ←) -->
            <LinearLayout
                android:id="@+id/ll_mini_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mini_titleNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/AppWhite"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_mini_artistNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/yugothic_ui_regular"
                    android:maxLines="1"
                    android:textColor="#919191"
                    android:textSize="11sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Guideline at 65% (right overlay closer to the play button, less invasive) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_mini_half"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.65" />

        <!-- Extended right fade (from 65% of the mini-player to the END of the play
             button). It used to end at the button's start and left a visible seam between
             the translucent overlay and the button background. The gradient now covers
             the play area too, and the icon floats on top as a floating ID. No touch capture. -->
        <View
            android:id="@+id/v_mini_textFade"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/mini_text_fade_right"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@+id/gl_mini_half"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Transparent layer that receives taps and swipes over the text area.
             Does not cover the play/pause button (constraint to its start). -->
        <View
            android:id="@+id/v_mini_swipeArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/b_mini_playPause"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_mini_playPause"
            style="@style/Widget.MaterialComponents.Button.IconOnly"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:backgroundTint="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            app:elevation="0dp"
            app:icon="@drawable/avd_ic_play"
            app:iconSize="28dp"
            app:iconTint="@color/AppWhite"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Progress bar at the bottom, from the cover end to the right edge -->
        <ProgressBar
            android:id="@+id/pb_mini_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/AppWhite"
            android:progressBackgroundTint="#3A3A3A"
            app:layout_constraintStart_toEndOf="@+id/iv_mini_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </com.jotapeveloper.fision.BlurBehindLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
