<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <TextView
        android:id="@+id/tv_singleChoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="5dp"
        android:paddingEnd="20dp"
        android:textColor="@color/AppWhite"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Options get inflated dynamically as TextViews inside this LinearLayout -->
    <LinearLayout
        android:id="@+id/ll_singleChoiceOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_singleChoiceCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="10dp"
        android:text="@android:string/cancel"
        android:textColor="@color/AppWhite"
        app:strokeColor="@color/colorPrimary"
        app:rippleColor="@color/colorPrimary"
        app:cornerRadius="30dp" />

</LinearLayout>
