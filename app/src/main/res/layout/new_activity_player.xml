<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

    <!-- Ambient nebula background: drawn first so it sits behind the UI stack.
         Palette + pulse are driven from PlayerActivity when the pref is on. -->
    <com.jotapeveloper.fision.NebulaBackgroundView
        android:id="@+id/v_nebula"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">



        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/player_toolbar_bg"
            android:minHeight="?attr/actionBarSize"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:theme="?attr/actionBarTheme">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_back"
                    android:contentDescription="@string/b_previous_description"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="0dp"
                    android:backgroundTint="@color/black"
                    app:icon="@drawable/ic_back_downside"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_SongTitle"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="5dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/noto_sans_regular"
                    android:marqueeRepeatLimit="3"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text=""
                    tools:text="@string/tv_SongTitle"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/b_back"
                    app:layout_constraintTop_toTopOf="@+id/b_back"
                    app:layout_constraintEnd_toStartOf="@+id/b_menu"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_menu"
                    android:contentDescription="@string/drawer_options_title"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    app:icon="@drawable/ic_menu"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Central container: wraps chords + stems + ITD overlay.
             The ITD view (include) is a sibling of the vertical stack and covers
             it whole, including the chords_container area. Without this, when
             chords_container is hidden the ITD view ceiling "jumped". -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/chords_container"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="1dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_chords"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_stemList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="1dp"
                        android:layout_marginEnd="1dp"
                        android:requiresFadingEdge="vertical"
                        android:fadingEdgeLength="28dp" />

                    <ProgressBar
                        android:id="@+id/pb_stemsLoading"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/colorPrimary"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Overlaid 3D view: covers the whole central area from toolbar
                 to bottomLayout, including the chords_container height. -->
            <include layout="@layout/player_3d_view" />
            <!-- Filament scene, inflated on first use (PlayerActivity.
                 ensureSceneInflated): a SurfaceView in the tree costs work
                 on every frame even while hidden, and the engine is heavy. -->
            <ViewStub
                android:id="@+id/stub_3d_scene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inflatedId="@+id/view3DScene_root"
                android:layout="@layout/player_3d_scene" />

            <!-- Overlaid lyrics view: same coverage as the ITD view above. -->
            <include layout="@layout/player_lyrics_view" />

            <!-- Chord diagrams (piano / guitar / ukulele), below the carousel. -->
            <include layout="@layout/player_chord_diagram_view" />

        </FrameLayout>


        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:text="@string/tv_bpm"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintTop_toTopOf="parent" />

            <SeekBar
                android:id="@+id/sb_progressBar"
                android:layout_width="match_parent"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_height="21dp"
                android:layout_marginTop="10dp"
                android:max="10000"
                android:progress="0"
                app:layout_constraintHorizontal_bias="0.506"
                app:layout_constraintTop_toTopOf="parent"
                />

            <LinearLayout
                android:id="@+id/durationLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_currentPos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/tv_currentPos"
                    android:fontFamily="@font/noto_sans_regular"
                    android:textColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/sb_progressBar"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="30dp"
                    android:fontFamily="@font/noto_sans_regular"
                    android:text="@string/tv_currentPos"
                    android:textColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/sb_progressBar"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/controlsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/b_seconds_back"
                        style="@style/Widget.MaterialComponents.Button.IconOnly"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/black"
                        android:contentDescription="@string/b_seconds_back_description"
                        android:onClick="moveBackward"
                        app:icon="@drawable/ic_seek_back_5"
                        app:iconSize="24dp"
                        app:iconTint="@color/white"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                    <TextView
                        android:id="@+id/tv_seconds_back_sign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|bottom"
                        android:layout_marginStart="-2dp"
                        android:text="-"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="30sp"
                        android:alpha="0"
                        android:elevation="12dp"
                        android:includeFontPadding="false" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_previous"
                    android:contentDescription="@string/b_previous_description"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_play"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/AppWhite"
                    android:contentDescription="@string/b_play_description"
                    android:onClick="Play"
                    app:icon="@drawable/avd_ic_play"
                    app:iconSize="42dp"
                    app:iconTint="@color/black"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_next"
                    android:contentDescription="@string/b_next_description"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/b_seconds_forward"
                        android:contentDescription="@string/b_seconds_forward_description"
                        style="@style/Widget.MaterialComponents.Button.IconOnly"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/black"
                        android:onClick="moveForward"
                        app:icon="@drawable/ic_seek_forward_5"
                        app:iconSize="24dp"
                        app:iconTint="@color/white"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                    <TextView
                        android:id="@+id/tv_seconds_forward_sign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-2dp"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="30sp"
                        android:alpha="0"
                        android:elevation="12dp"
                        android:includeFontPadding="false" />
                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/optionsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="5dp"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_repeat"
                    android:contentDescription="@string/b_repeat_description"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    app:icon="@drawable/ic_repeat"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_lyrics"
                    android:contentDescription="@string/lyrics_button_description"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    app:icon="@drawable/ic_lyrics"
                    app:iconSize="32dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_pitch"
                    android:contentDescription="pitch"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    app:icon="@drawable/ic_pitch"
                    app:iconSize="28dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_metronome"
                    android:contentDescription="metronome"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    app:icon="@drawable/ic_metronome"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_chord"
                    android:contentDescription="show/hide chords"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="20dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    app:icon="@drawable/ic_chord_carousel"
                    app:iconSize="36dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_3d"
                    android:contentDescription="3D spatial audio"
                    style="@style/Widget.MaterialComponents.Button.IconOnly"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/black"
                    app:icon="@drawable/ic_itd"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right side drawer with player options -->
    <include
        android:id="@+id/right_drawer"
        layout="@layout/player_right_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
