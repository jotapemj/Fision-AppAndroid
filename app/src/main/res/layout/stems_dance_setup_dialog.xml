<?xml version="1.0" encoding="utf-8"?>
<!--
  Stems dance setup dialog. Lets the user pick which ones dance
  and tune the initial speed and distance. The outer ScrollView only
  engages as a safety net when a large stem catalog outgrows the screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/delete_dialogbg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/yugothic_ui_regular"
        android:text="@string/stems_dance_title"
        android:textColor="@color/AppWhite"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Tile grid (all stems visible, no inner scroll); PlayerActivity binds
         a DanceStemTileAdapter. Each tile: stem selection + swing toggle.
         Negative margins compensate the tiles' own 5dp margins so the grid
         edges align with the rest of the dialog content. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dance_stems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-5dp"
        android:layout_marginEnd="-5dp"
        android:layout_marginBottom="14dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Random swing start (scene mode only). Speed and distance live in
         the inline sliders of the 3D view. Label is not translatable. -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_dance_random_swing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/yugothic_ui_regular"
        android:text="Randomize swing"
        android:textColor="@color/AppWhite"
        android:textSize="14sp"
        app:buttonTint="?attr/colorPrimary"
        tools:ignore="HardcodedText" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_dance_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:padding="10dp"
            android:text="@string/NO"
            android:textColor="@color/AppWhite"
            app:strokeColor="?attr/colorPrimary"
            app:rippleColor="?attr/colorPrimary"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_dance_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:text="@string/stems_dance_start"
            android:textColor="@color/AppWhite"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="20dp" />
    </LinearLayout>

</LinearLayout>

</ScrollView>
