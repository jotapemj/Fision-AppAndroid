<?xml version="1.0" encoding="utf-8"?>
<!--
  Player 3D view. Shown on tapping the b_3d button and replaces
  rv_stemList + rv_chords visually.

  Child order (important — FrameLayout stacks in declaration order):
    1. fl_3d_stemContainer (icons)
    2. iv_3d_head (listener head)
    3. v_3d_darkOverlay (black layer: "lights off" effect when 3D=off)
    4. header (title + info button + switch) — above the overlay so it stays clickable
    5. VerticalSlider elevation + value tooltip
    6. actions legend (bottom left) + reset button (bottom right)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view3D_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_3d_synthwave"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- 1) Stem icons + listener head, in one parent so their Z orders them: the
         camera sits behind the head, stems in front of the listener pass behind it.
         The head takes no touches, so a hidden stem can still be grabbed. -->
    <FrameLayout
        android:id="@+id/fl_3d_stemContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_3d_head"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="190dp"
            android:scaleType="fitCenter"
            android:src="@drawable/head_filled"
            android:contentDescription="@string/cd_listener_head" />
    </FrameLayout>

    <!-- 3) Dim layer: lights off effect when 3D=off. Vertical gradient so the
         top and bottom fade to transparent — avoids a hard seam against the
         toolbar fade above and the bottom controls / animated background
         below. The View alpha itself is animated by the 3D switch. -->
    <View
        android:id="@+id/v_3d_darkOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_3d_dark_overlay"
        android:alpha="0.72"
        android:clickable="false"
        android:focusable="false" />

    <!-- 4) Header: title + info button + switch -->
    <LinearLayout
        android:id="@+id/ll_3d_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_gravity="top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_regular"
            android:text="@string/audio3d_title"
            android:textColor="@color/AppWhite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/b_3d_info"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            app:tint="@color/AppWhite"
            android:contentDescription="@string/audio3d_info_title" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_3d_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 5) Vertical elevation slider + value tooltip -->
    <com.jotapeveloper.fision.VerticalSlider
        android:id="@+id/sb_3d_elevation"
        android:layout_width="40dp"
        android:layout_height="240dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/tv_3d_elevation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/elevation_tooltip_bg"
        android:fontFamily="@font/noto_sans_regular"
        android:textColor="@color/AppWhite"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="0°"
        android:visibility="gone" />

    <!-- 6) Bottom row: dance/reset buttons (stacked) + dance panel, as in the scene.
         The reset button hides as INVISIBLE so the dance button stays in place. -->
    <LinearLayout
        android:id="@+id/ll_3d_bottomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_3d_dance"
                style="@style/Widget.MaterialComponents.Button.IconOnly"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:backgroundTint="?attr/colorPrimary"
                android:contentDescription="@string/stems_dance_title"
                app:icon="@raw/ic_play"
                app:iconSize="22dp"
                app:iconTint="@color/AppWhite"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_3d_reset"
                style="@style/Widget.MaterialComponents.Button.IconOnly"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:backgroundTint="?attr/colorPrimary"
                android:contentDescription="@string/audio3d_legend_reset"
                app:icon="@drawable/ic_restore_pan"
                app:iconSize="22dp"
                app:iconTint="@color/AppWhite"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
        </LinearLayout>

        <include layout="@layout/player_3d_dance_panel" />
    </LinearLayout>

</FrameLayout>
