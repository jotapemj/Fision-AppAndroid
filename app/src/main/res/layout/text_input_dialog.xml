<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <TextView
        android:id="@+id/tv_textInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/noto_sans_regular"
        android:textColor="@color/AppWhite"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_textInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        style="@style/Widget.Fision.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_textInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/EditTextHandleTheme"
            android:textColor="@color/AppWhite"
            android:textCursorDrawable="@drawable/cursor_primary"
            android:fontFamily="@font/noto_sans_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_textInputCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:padding="10dp"
            android:text="@string/NO"
            android:textColor="@color/AppWhite"
            app:strokeColor="?attr/colorPrimary"
            app:rippleColor="?attr/colorPrimary"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_textInputSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:text="@string/save"
            android:textColor="@color/AppWhite"
            android:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="20dp" />
    </LinearLayout>

</LinearLayout>
