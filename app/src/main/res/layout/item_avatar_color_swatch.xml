<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_swatchWrap"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:layout_gravity="center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Ring is INVISIBLE (not GONE) so the wrapper size never changes
         between selected/unselected states — the fill stays centred. -->
    <View
        android:id="@+id/v_swatchRing"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/avatar_swatch_ring"
        android:visibility="invisible" />

    <View
        android:id="@+id/v_swatchFill"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/avatar_swatch_dot" />
</FrameLayout>
