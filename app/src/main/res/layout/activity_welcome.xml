<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.jotapeveloper.fision.brand.WelcomeBackdropView
        android:id="@+id/v_welcomeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_welcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/ll_welcomeDots" />

    <LinearLayout
        android:id="@+id/ll_welcomeDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/fl_welcomeActions" />

    <FrameLayout
        android:id="@+id/fl_welcomeActions"
        android:layout_width="0dp"
        android:layout_height="122dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_welcomeNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:fontFamily="@font/noto_sans_regular"
            android:text="@string/coach_next"
            android:textAllCaps="false"
            android:textColor="@color/AppWhite"
            android:textSize="16sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="28dp" />

        <LinearLayout
            android:id="@+id/ll_welcomeChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:alpha="0"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_welcomeServer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/noto_sans_regular"
                android:text="@string/welcome_connect"
                android:textAllCaps="false"
                android:textColor="@color/AppWhite"
                android:textSize="16sp"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/b_welcomeLocal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/noto_sans_regular"
                android:text="@string/welcome_local"
                android:textAllCaps="false"
                android:textColor="@color/AppWhite"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:rippleColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
