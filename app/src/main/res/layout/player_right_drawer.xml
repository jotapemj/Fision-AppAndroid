<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:clickable="true"
    android:focusable="true"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="14dp"
        android:text="@string/drawer_options_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/yugothic_ui_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />

    <!-- Chords: basic vs advanced (per song) -->
    <LinearLayout
        android:id="@+id/drawer_item_chords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chord"
            android:contentDescription="@string/drawer_item_chords" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_drawer_chords_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_item_chords"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/yugothic_ui_regular" />

            <TextView
                android:id="@+id/tv_drawer_chords_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/chords_advanced"
                android:textColor="#919191"
                android:textSize="13sp"
                android:fontFamily="@font/yugothic_ui_regular" />

        </LinearLayout>

    </LinearLayout>

    <!-- Notation: American vs Latin (global) -->
    <LinearLayout
        android:id="@+id/drawer_item_cifrado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notation"
            android:contentDescription="@string/drawer_item_cifrado" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_item_cifrado"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/yugothic_ui_regular" />

            <TextView
                android:id="@+id/tv_drawer_cifrado_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cifrado_american"
                android:textColor="#919191"
                android:textSize="13sp"
                android:fontFamily="@font/yugothic_ui_regular" />

        </LinearLayout>

    </LinearLayout>

    <!-- Notation: flat vs sharp (global) -->
    <LinearLayout
        android:id="@+id/drawer_item_notation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flat_sharp"
            android:contentDescription="@string/drawer_item_notation" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_item_notation"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/yugothic_ui_regular" />

            <TextView
                android:id="@+id/tv_drawer_notation_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/notation_sharp"
                android:textColor="#919191"
                android:textSize="13sp"
                android:fontFamily="@font/yugothic_ui_regular" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <!-- Switch: transpose with pitch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pitch"
            android:contentDescription="@string/drawer_switch_transposition" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/drawer_switch_transposition"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/yugothic_ui_regular" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_drawer_transposition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Switch: downbeat sound (per song) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_metronome"
            android:contentDescription="@string/drawer_switch_downbeat" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/drawer_switch_downbeat"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/yugothic_ui_regular" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_drawer_downbeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Sub-item: downbeat sound picker (only visible when the switch is on) -->
    <LinearLayout
        android:id="@+id/drawer_item_downbeat_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="62dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/drawer_item_downbeat_sound"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/yugothic_ui_regular" />

        <TextView
            android:id="@+id/tv_drawer_downbeat_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/downbeat_sound_clap"
            android:textColor="#919191"
            android:textSize="13sp"
            android:fontFamily="@font/yugothic_ui_regular" />

    </LinearLayout>

    <!-- Switch: continue playlist from this song (global) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_playlist"
            app:tint="#FFFFFF"
            android:contentDescription="@string/drawer_switch_playlist" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/drawer_switch_playlist"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/yugothic_ui_regular" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_drawer_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Switch: nebula background (global) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nebula"
            app:tint="#FFFFFF"
            android:contentDescription="@string/drawer_switch_nebula" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/drawer_switch_nebula"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/yugothic_ui_regular" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_drawer_nebula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <!-- Reset to default (volumes, pan, etc.) -->
    <LinearLayout
        android:id="@+id/drawer_item_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_restore_pan"
            app:tint="#FFFFFF"
            android:contentDescription="@string/drawer_item_reset" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drawer_item_reset"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/yugothic_ui_regular" />

    </LinearLayout>

    <!-- Reprocess on the server: reopens the separation wizard on the
         mp3 already stored on the server. Visible only if the song came from the cloud. -->
    <LinearLayout
        android:id="@+id/drawer_item_reprocess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reprocess"
            app:tint="#FFFFFF"
            android:contentDescription="@string/drawer_item_reprocess" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drawer_item_reprocess"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/yugothic_ui_regular" />

    </LinearLayout>

    <!-- Export (current mix / separated tracks) -->
    <LinearLayout
        android:id="@+id/drawer_item_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_export"
            android:contentDescription="@string/drawer_item_export" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drawer_item_export"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/yugothic_ui_regular" />

    </LinearLayout>

</LinearLayout>
</ScrollView>
