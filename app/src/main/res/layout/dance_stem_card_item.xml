<?xml version="1.0" encoding="utf-8"?>
<!-- Card row for the stems dance dialog: icon + name, a thin vertical
     divider, and the per-stem sine-wave (up/down oscillation) toggle.
     Selection is signalled by an overlay ring (alpha-toggled). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dance_stem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/iv_dance_stem_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_export" />

        <TextView
            android:id="@+id/tv_dance_stem_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/yugothic_ui_regular"
            android:textColor="@color/AppWhite"
            android:textSize="14sp"
            tools:text="Bass" />

        <!-- Thin vertical divider between the name and the wave toggle.
             Shorter than the row so it never touches top/bottom. -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#4D808080" />

        <ImageView
            android:id="@+id/iv_dance_stem_sine"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sine_wave"
            android:contentDescription="@string/stems_dance_sine"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Selection ring, drawn on top of the content. The adapter toggles
         its ALPHA only — a runtime stroke-color change on the card itself
         made it re-measure and shrink to the text width inside the list. -->
    <View
        android:id="@+id/v_dance_stem_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</com.google.android.material.card.MaterialCardView>
