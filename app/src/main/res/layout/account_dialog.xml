<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <FrameLayout
        android:id="@+id/fl_accountAvatarWrap"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center|top"
            android:background="@drawable/avatar_circle_bg">
            <TextView
                android:id="@+id/tv_accountInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/yugothic_ui_regular"
                android:textStyle="bold"
                android:textColor="#CFCFCF"
                android:textSize="34sp"
                tools:text="J" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_accountAvatar"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_accountEditBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|bottom"
            android:padding="6dp"
            android:background="@drawable/avatar_edit_badge_bg"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/account_change_photo"
            app:tint="@color/AppWhite" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_accountUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textColor="@color/AppWhite"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="jotapeveloper" />

    <TextView
        android:id="@+id/tv_accountUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        tools:text="Server: http://192.168.1.50:8000" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_accountRemovePhoto"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:padding="10dp"
        android:text="@string/account_remove_photo"
        android:textColor="@color/AppWhite"
        app:strokeColor="?attr/colorPrimary"
        app:rippleColor="?attr/colorPrimary"
        app:cornerRadius="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/b_accountChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/account_change_password"
        android:textColor="@color/AppWhite"
        android:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="20dp" />

</LinearLayout>
