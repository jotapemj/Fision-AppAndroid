<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist cover options: pick from the device, song mosaic, or the
     plain Fision art. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp"
    android:background="@drawable/dialogbg">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_round_remove_24"
        android:layout_gravity="center|top"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:fontFamily="@font/noto_sans_regular"
        android:text="@string/playlist_change_cover"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/b_coverPick"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/ic_image"
        android:drawablePadding="16dp"
        android:fontFamily="@font/noto_sans_regular"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:text="@string/playlist_cover_pick"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/b_coverMosaic"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/ic_grid_view"
        android:drawablePadding="16dp"
        android:fontFamily="@font/noto_sans_regular"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:text="@string/playlist_cover_mosaic"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/b_coverRemove"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/ic_delete"
        android:drawablePadding="16dp"
        android:fontFamily="@font/noto_sans_regular"
        android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:text="@string/playlist_remove_cover"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
