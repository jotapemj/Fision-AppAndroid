<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="170dp"
    android:padding="4dp"
    android:background="@drawable/stem_context_menu_bg">

    <TextView
        android:id="@+id/tv_avatarMenuChange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_image"
        android:drawablePadding="12dp"
        android:drawableTint="#DDDDDD"
        android:fontFamily="@font/noto_sans_regular"
        android:gravity="center_vertical"
        android:textColor="@color/AppWhite"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/account_change_photo" />

    <TextView
        android:id="@+id/tv_avatarMenuRemove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="12dp"
        android:drawableTint="@color/cloud_offline"
        android:fontFamily="@font/noto_sans_regular"
        android:gravity="center_vertical"
        android:textColor="@color/cloud_offline"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/account_remove_photo" />

</LinearLayout>
