<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:padding="24dp"
    android:background="@drawable/delete_dialogbg">

    <TextView
        android:id="@+id/tv_cpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="18dp"
        android:fontFamily="@font/yugothic_ui_regular"
        android:text="@string/change_password_title"
        android:textColor="@color/AppWhite"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cpOld"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="@string/change_password_hint_old"
        app:boxStrokeColor="@color/AppWhite"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@color/AppWhite"
        android:textColorHint="#9E9E9E"
        app:cursorColor="@color/colorPrimary"
        app:cursorErrorColor="@color/colorPrimary"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/AppWhite">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cpOld"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/EditTextHandleTheme"
            android:inputType="textPassword"
            android:textColor="@color/AppWhite"
            android:textCursorDrawable="@drawable/cursor_primary"
            android:fontFamily="@font/yugothic_ui_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cpNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="@string/change_password_hint_new"
        app:boxStrokeColor="@color/AppWhite"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@color/AppWhite"
        android:textColorHint="#9E9E9E"
        app:cursorColor="@color/colorPrimary"
        app:cursorErrorColor="@color/colorPrimary"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/AppWhite">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cpNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/EditTextHandleTheme"
            android:inputType="textPassword"
            android:textColor="@color/AppWhite"
            android:textCursorDrawable="@drawable/cursor_primary"
            android:fontFamily="@font/yugothic_ui_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cpConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="@string/change_password_hint_confirm"
        app:boxStrokeColor="@color/AppWhite"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@color/AppWhite"
        android:textColorHint="#9E9E9E"
        app:cursorColor="@color/colorPrimary"
        app:cursorErrorColor="@color/colorPrimary"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/AppWhite">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cpConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/EditTextHandleTheme"
            android:inputType="textPassword"
            android:textColor="@color/AppWhite"
            android:textCursorDrawable="@drawable/cursor_primary"
            android:fontFamily="@font/yugothic_ui_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_cpError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        android:gravity="center"
        android:fontFamily="@font/yugothic_ui_regular"
        android:textColor="@color/cloud_offline"
        android:textSize="12sp"
        tools:text="Error"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/pb_cpSpinner"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:indeterminateTint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_cpCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:padding="10dp"
            android:text="@string/NO"
            android:textColor="@color/AppWhite"
            app:strokeColor="@color/colorPrimary"
            app:rippleColor="@color/colorPrimary"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/b_cpSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:text="@string/change_password_submit"
            android:textColor="@color/AppWhite"
            android:backgroundTint="@color/colorPrimary"
            app:cornerRadius="20dp" />
    </LinearLayout>

</LinearLayout>
