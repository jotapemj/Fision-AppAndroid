<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/settings_title">
        <ListPreference
            android:key="language"
            android:title="Language"
            android:summary="Select your preferred language"
            android:defaultValue="en"
            android:entries="@array/lang_entries"
            android:entryValues="@array/lang_entries_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/server_section_title">
        <Preference
            android:key="server_url"
            android:title="@string/server_url_title"
            android:summary="@string/server_url_summary" />
        <Preference
            android:key="server_test"
            android:title="@string/server_test_title"
            android:summary="@string/server_test_summary" />
        <Preference
            android:key="server_token"
            android:title="@string/server_token_title"
            android:summary="@string/server_token_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about_section_title">
        <Preference
            android:key="about"
            android:title="@string/about_title"
            android:summary="@string/about_summary" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>