<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer (API 31+). The session token never leaves the
    device: its prefs file is encrypted with a Keystore key that is not
    restored, and a plain fallback copy must not reach a backup either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fision_server_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fision_server_secure.xml" />
    </device-transfer>
</data-extraction-rules>
