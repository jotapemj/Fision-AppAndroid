<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Foreground service for server downloads (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Fision server on LAN/Tailscale: HTTP to the configured host -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometrics to reveal/edit the Bearer token -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Haptic feedback for the ruler pickers (pitch/tempo). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Storage to Export to /Fision/<song>/ at the root of storage.
         API <= 28: WRITE_EXTERNAL_STORAGE (declared with maxSdkVersion).
         API >= 30: MANAGE_EXTERNAL_STORAGE — must be granted manually in system
         Settings (the special "All files access" screen). Without it, the export
         shows "Export failed". -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".FisionApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fision"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Splash screen -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main player -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- PlayerActivity: player UI (drives the PlaybackService) -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- ImportActivity: sends audio to the server to separate stems -->
        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Share target: audio shared from other apps opens the import at the
             separation picker. Only the shared stream is read from this entry. -->
        <activity-alias
            android:name=".ShareToFision"
            android:targetActivity=".ImportActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp3" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/wave" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/x-flac" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/x-m4a" />
                <data android:mimeType="audio/m4a" />
                <data android:mimeType="audio/aac" />
                <data android:mimeType="audio/ogg" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="audio/opus" />
                <data android:mimeType="audio/aiff" />
                <data android:mimeType="audio/x-aiff" />
                <data android:mimeType="audio/x-ms-wma" />
            </intent-filter>
        </activity-alias>

        <!-- PlaylistActivity: one playlist and its songs -->
        <activity
            android:name=".PlaylistActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- PlaylistEditActivity: create / edit a playlist -->
        <activity
            android:name=".PlaylistEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- CropAvatarActivity: circular crop for the profile picture -->
        <activity
            android:name=".CropAvatarActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- LicensesActivity: list of open-source dependencies -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- LicenseDetailActivity: full text of a single licence -->
        <activity
            android:name=".LicenseDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Foreground service: persistent audio engine. Exported as a media
             browser for Android Auto; onGetRoot only accepts the app itself
             and Android Auto. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Foreground service: Fision server downloads (persist when going to background) -->
        <service
            android:name=".cloud.FisionDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Per-app UI language below Android 13: AppCompat stores and restores it. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Song covers for Android Auto (read access granted per URI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cover_paths" />
        </provider>

        <!-- Android Auto: media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>

</manifest>
