<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- rv_stemList (vertical, inside a weighted FrameLayout) and rv_chords
         (horizontal, inside a 70dp container) scroll with match_parent inside
         parents of fixed size, so setHasFixedSize(true) is valid on both. The
         androidx rule reads the node's own layout value and never resolves
         match_parent through the parent, which made lintVitalRelease abort on
         every release build. Kept as a warning: release builds pass and the
         rule keeps reporting real wrap_content uses. -->
    <issue id="InvalidSetHasFixedSize" severity="warning" />
</lint>
